<style>
    body {
        font-family: 'Lato', sans-serif;
        text-align: center;
    }

    .video-wrapper {
        position: relative;
        width: 100%;
        height: 800px;
        overflow: hidden;
    }

    .video-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .video-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.800);
        z-index: 1;
    }

    .hero-content {
        position: absolute;
        z-index: 2;
        color: white;
        top: 120px;
        /* adjust this */
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        /* stack items vertically */
        align-items: center;
        /* optional: centers horizontally */
        gap: 20px;
        /* 👈 controls space between each element */
    }

    .hero-content h2 {
        font-size: 25px;
        margin-top: 50px;
    }

    .hero-content h1 {
        font-family: 'Arapey', serif;
        font-size: 60px;
    }

    .header-button {
        margin-top: 10px;
        background: #ffffff;
        font-size: 20px;
        padding: 10px 30px;
        color: #000000;
    }

    .video-navbar-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 3;
    }

    .site-logo {
        height: 300px;
        width: 100%;
        display: block;
        /* border: 2px solid red; */
    }
</style>

<div class="video-wrapper">

    <!-- ✅ Navbar Over Video -->
    <div class="video-navbar-wrapper">
        {% render 'video-navbar' %}
    </div>

    <video autoplay muted loop playsinline>
        <source src="{{ 'leather_crafting_header_video.mp4' | asset_url }}" type="video/mp4">
    </video>

    <div class="video-overlay"></div>

    <div class="hero-content">
        <img src="{{ 'ACL-New-logo.svg' | asset_url }}" class="site-logo">
        <h2>New Collection</h2>
        <h1>TIMELESS LEATHER GOODS</h1>
        <a class="header-button" href="#" target="_blank" alt="shop button">Shop Now</a>
    </div>
</div>