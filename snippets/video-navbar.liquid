<style>
    [x-cloak] {
        display: none !important;
    }

    /* ===============================
   Desktop Navbar
================================= */
    .navbar {
        display: none;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 1rem 2rem;
        margin-top: 1rem;
    }

    @media (min-width: 768px) {
        .navbar {
            display: flex;
        }
    }

    .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 75%;
    }

    .nav-links {
        display: flex;
        gap: 2rem;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.125rem;
        font-weight: 400;
        color: #ffffff;
        text-decoration: none;
        padding: 0.5rem 0;
    }

    .nav-link:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .nav-arrow {
        width: 16px;
        height: 16px;
    }

    .nav-icons {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .nav-icons button svg {
        display: inline-flex;
        /* ensures SVG shows up */
        vertical-align: middle;
        /* aligns with other icons */
        width: 24px;
        /* control size */
        height: 24px;
        /* control size */
        color: white;
        /* Tailwind may also use text-white */
    }

    /* Mobile search button */
    .mobile-search-button svg {
        color: white;
        width: 24px;
        height: 24px;
    }
</style>

<div x-data="{open: false, searchBarButtonOpen: false, searchBarButtonOpenMobile: false}" x-init="
    window.addEventListener('pageshow', () => {
        searchBarButtonOpen = false;
        searchBarButtonOpenMobile = false;
        document.body.style.overflow = 'auto';

        const input = document.querySelector('input[name=q]');
        if (input) input.value = '';
    })
  " class="w-full mx-auto pt-5">

    <!-- ================= MOBILE NAV ================= -->
    <div class="flex items-center justify-between px-4 py-3 md:hidden">

        <!-- Hamburger -->
        <button @click="open = !open" :aria-expanded="open.toString()" class="text-white">
            <svg class="h-6 w-6" x-show="!open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="h-6 w-6" x-show="open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Logo -->
        {% comment %} <a href="{{ shop.url }}">
            {% if logo == blank %}
            <img class="w-[120px]" src="{{ 'logo.png' | asset_url }}" alt="Logo">
            {% else %}
            <img class="w-[120px]" src="{{ logo | img_url: 'master' }}" alt="Logo">
            {% endif %}
        </a> {% endcomment %}

        <!-- Mobile Icons -->
        <div class="flex items-center space-x-4">
            <button class="mobile-search-button"
                @click="searchBarButtonOpenMobile = true; document.body.style.overflow='hidden'">
                {% render 'icon-search' %}
            </button>
            {% render 'icon-cart' %}
        </div>
    </div>

    <!-- Mobile Slide Menu -->
    <div class="bg-[#FEB82B]/20 md:hidden" x-show="open" x-transition x-cloak>
        <div class="flex flex-col px-4 pt-6 space-y-2">
            {% for link in linklists.main-menu.links %}
            <a class="block py-2 text-black" href="{{ link.url }}">
                {{ link.title }}
            </a>
            {% endfor %}
        </div>
    </div>


    <!-- ================= DESKTOP NAV ================= -->
    <div class="navbar">

        <div class="nav-inner">

            <!-- Left Links -->
            <div class="nav-links">
                {% for link in linklists.main-menu.links %}
                {% if forloop.index <= 3 %} <a class="nav-link" href="{{ link.url }}">
                    <span>{{ link.title }}</span>

                    {% if link.links.size > 0 %}
                    <img src="{{ 'down-arrow.png' | asset_url }}" class="nav-arrow">
                    {% endif %}
                    </a>
                    {% endif %}
                    {% endfor %}
            </div>

            <!-- Right Links -->
            <div class="nav-links">
                {% for link in linklists.main-menu.links %}
                {% if forloop.index > 3 %}
                <a class="nav-link" href="{{ link.url }}">
                    {{ link.title }}
                </a>
                {% endif %}
                {% endfor %}
            </div>

        </div>

        <!-- Icons -->
        <div class="nav-icons flex items-center gap-8">
            <button @click="searchBarButtonOpen = true; document.body.style.overflow='hidden'">
                {% render 'icon-search' %}
            </button>
            {% render 'icon-cart' %}
        </div>

    </div>


    <!-- ================= SEARCH MODAL ================= -->
    <div x-show="searchBarButtonOpen || searchBarButtonOpenMobile"
        class="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50" x-cloak>

        <!-- CLOSE BUTTON -->
        <button @click="searchBarButtonOpen=false; searchBarButtonOpenMobile=false; document.body.style.overflow='auto'"
            class="fixed top-4 right-4 text-2xl text-white z-[60]">
            ✖
        </button>

        <!-- WHITE MODAL BOX -->
        <div class="bg-white p-4 rounded-md w-3/4 md:w-1/3">
            <form action="/search" method="get">
                <input type="text" name="q" placeholder="Search..." class="w-full px-4 py-2 border rounded-md" />
                <button type="submit" class="mt-2 w-full bg-[#FEB82B] text-white py-2 rounded-md">
                    Search
                </button>
            </form>
        </div>

    </div>

</div>